{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/jewellery/:path*",
      "destination": "/Jewellery/:path*"
    },
    {
      "source": "/jewellery",
      "destination": "/Jewellery/index.html"
    },
    {
      "source": "/watch/:path*",
      "destination": "/Watch%203D/:path*"
    },
    {
      "source": "/watch",
      "destination": "/Watch%203D/index.html"
    },
    {
      "source": "/perfume/:path*",
      "destination": "/Perfume/:path*"
    },
    {
      "source": "/perfume",
      "destination": "/Perfume/index.html"
    }
  ]
}
